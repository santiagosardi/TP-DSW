        <mxCell id="reglas" value="&lt;b&gt;Claves y reglas verificadas en migraciones&lt;/b&gt;&lt;br&gt;Las 7 tablas principales tienen PK id autoincremental. Las 4 asociativas tienen PK compuesta, sin id adicional.&lt;br&gt;Las 11 FK dibujadas declaran ON DELETE CASCADE. Las 8 FK de tablas asociativas también declaran ON UPDATE CASCADE.&lt;br&gt;Las fechas de creación/agregado las asigna el ORM; las migraciones no declaran DEFAULT CURRENT_TIMESTAMP.&lt;br&gt;Se representan tablas de negocio; el control interno de migraciones no forma parte de este DER." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=17;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry y="1380" width="1480" as="geometry" height="145" x="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>